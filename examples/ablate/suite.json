      "input": "shipping",
      "reference": "Orders ship in 2 days.",
      "assertions": [{"kind": "exact_match"}]
    },
    {
      "id": "warranty",
      "input": "warranty",
      "reference": "The warranty lasts 1 year.",
      "assertions": [{"kind": "exact_match"}]
    }
  ]
