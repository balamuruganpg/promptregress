{
  "name": "traces",
  "description": "Agent tasks scored with trace_match. Each case expects an ordered tool trace. Arg values match as case-sensitive substrings.",
  "cases": [
    {
      "id": "refund",
      "input": "id: refund\nSupport agent. The customer wants a refund for order 1001. Search the knowledge base, load the order, and issue the refund.",
      "reference": "[{\"tool\": \"search_kb\", \"args\": {\"query\": \"refund policy\"}}, {\"tool\": \"get_order\", \"args\": {\"order_id\": \"1001\"}}, {\"tool\": \"issue_refund\", \"args\": {\"order_id\": \"1001\", \"amount\": \"20.00\"}}]",
      "tags": [
        "support",
        "billing"
      ],
      "metadata": {
        "agent": "support"
      },
      "assertions": [
        {
          "kind": "trace_match",
          "value": [
            {
              "tool": "search_kb",
              "args": {
                "query": "refund policy"
              }
            },
            {
              "tool": "get_order",
              "args": {
                "order_id": "1001"
              }
            },
            {
              "tool": "issue_refund",
              "args": {
                "order_id": "1001",
                "amount": "20.00"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "shipping",
      "input": "id: shipping-status\nSupport agent. Tell the customer where parcel 1Z999 is. Search shipping notes, load the shipment, and email Ada.",
      "reference": "[{\"tool\": \"search_kb\", \"args\": {\"query\": \"shipping status\"}}, {\"tool\": \"get_shipment\", \"args\": {\"tracking\": \"1Z999\"}}, {\"tool\": \"email_customer\", \"args\": {\"to\": \"ada@example.com\"}}]",
      "tags": [
        "support",
        "shipping"
      ],
      "metadata": {
        "agent": "support"
      },
      "assertions": [
        {
          "kind": "trace_match",
          "value": [
            {
              "tool": "search_kb",
              "args": {
                "query": "shipping status"
              }
            },
            {
              "tool": "get_shipment",
              "args": {
                "tracking": "1Z999"
              }
            },
            {
              "tool": "email_customer",
              "args": {
                "to": "ada@example.com"
              }
            }
          ]
        }
      ]
    },
